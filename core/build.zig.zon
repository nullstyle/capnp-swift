            .url = "https://github.com/nullstyle/capnp-zig/archive/refs/tags/v0.20.0.tar.gz",
            .hash = "capnpc_zig-0.20.0-nUduFXM1RwDO9CsVGFgZowhDNaDZ5V5-10qgILp63pqV",
